# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.ipynb_checkpoints/

# Data artifacts (downloaded / generated) — directories kept via .gitkeep
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# SQLite database (generated by the pipeline)
*.db
*.sqlite
*.sqlite3

# Trained models (regenerated by `pipeline train`)
models/

# Generated Pages report (built by report.py / GitHub Actions)
reports/site/

# The prospective forecast log. It lives on its own append-only data branch, checked out into
# .forecast-log/ by the refresh workflow — never committed to main, where a daily append would
# bury the code history. A local `report --log` writes here too.
.forecast-log/
forecasts.jsonl

# IDE / editor
.idea/
.vscode/
*.iml

# Local assistant session notes and settings — machine-local, not project history. The skills
# directory is the exception: it holds project tooling (the page measurement over CDP), which
# belongs to the repository for the same reason `pipeline` does — a procedure that only exists
# on one machine is a procedure that gets re-derived, and this one has been got wrong twice.
.claude/*
!.claude/skills/

# OS
.DS_Store
Thumbs.db

# Lokalny indeks CodeGraph (graf kodu per maszyna, odbudowywalny przez `codegraph init`)
.codegraph/
# Added by code-review-graph
.code-review-graph/
